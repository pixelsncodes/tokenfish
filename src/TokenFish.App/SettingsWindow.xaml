<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TokenFish.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TokenFish Settings"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Padding="24"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="TokenFish Settings" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Saved runtime changes apply after TokenFish is restarted."
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Codex runtime" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Choose how TokenFish starts the existing Codex app server. Changes are saved for the next launch."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="RuntimeModeLabel"
                        FontWeight="SemiBold"
                        Text="Runtime mode" />
                    <ComboBox
                        x:Name="RuntimeModeComboBox"
                        MinWidth="260"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Runtime mode"
                        SelectionChanged="OnRuntimeModeSelectionChanged" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="WslDistributionLabel"
                        FontWeight="SemiBold"
                        Text="WSL distribution name" />
                    <TextBox
                        x:Name="WslDistributionTextBox"
                        AutomationProperties.Name="WSL distribution name"
                        PlaceholderText="Optional"
                        TextChanged="OnWslDistributionTextChanged" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Leave empty to use the default WSL distribution."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    x:Name="StatusBorder"
                    Padding="10,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <TextBlock
                        x:Name="StatusTextBlock"
                        AutomationProperties.LiveSetting="Polite"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="CloseButton"
                Grid.Column="1"
                Click="OnCloseClicked"
                Content="Close" />
            <Button
                x:Name="SaveButton"
                Grid.Column="2"
                Click="OnSaveClicked"
                Content="Save" />
        </Grid>
    </Grid>
</Window>
