<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TokenFish.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TokenFish Settings"
    mc:Ignorable="d">
    <Grid
        x:Name="RootGrid"
        Padding="24"
        Background="{ThemeResource TokenFishSurfaceBrush}"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="TokenFish Settings" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Make TokenFish feel at home on your desktop."
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <Button x:Name="ConnectionsTab" Content="Connections" Tag="connections" Click="OnSectionClicked" />
                <Button x:Name="DesktopTab" Content="Desktop" Tag="desktop" Click="OnSectionClicked" />
                <Button x:Name="AppearanceTab" Content="Appearance" Tag="appearance" Click="OnSectionClicked" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
            <StackPanel x:Name="ConnectionsPanel" Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Providers" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Choose which local provider data TokenFish shows after the next launch."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Spacing="2">
                        <RadioButton
                            x:Name="CodexProviderRadioButton"
                            AutomationProperties.Name="Provider Codex"
                            Checked="OnProviderSelectionChecked"
                            Content="Codex" />
                        <TextBlock
                            Margin="32,0,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Reads usage through the configured Codex runtime."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <RadioButton
                            x:Name="ClaudeProviderRadioButton"
                            AutomationProperties.Name="Provider Claude"
                            Checked="OnProviderSelectionChecked"
                            Content="Claude" />
                        <TextBlock
                            Margin="32,0,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Reads normalized usage received through the local TokenFish Claude bridge."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <RadioButton
                            x:Name="BothProvidersRadioButton"
                            AutomationProperties.Name="Provider Codex and Claude"
                            Checked="OnProviderSelectionChecked"
                            Content="Codex and Claude" />
                        <TextBlock
                            Margin="32,0,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Shows both providers."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="ProviderReadinessSection"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Current provider readiness" />
                    <StackPanel
                        x:Name="ProviderReadinessRowsStackPanel"
                        Spacing="8" />
                </StackPanel>

                <Expander
                    x:Name="ClaudeSetupSection"
                    Header="Claude setup instructions"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="ClaudeSetupDescriptionTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Bridge executable" />
                        <TextBlock
                            x:Name="ClaudeBridgeExecutablePathTextBlock"
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Claude Code on Windows" />
                        <TextBox
                            x:Name="ClaudeStatusLineSettingsTextBox"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            Height="116"
                            IsReadOnly="True"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Claude Code inside WSL" />
                        <TextBox
                            x:Name="ClaudeWslStatusLineSettingsTextBox"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            Height="116"
                            IsReadOnly="True"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        x:Name="ClaudeSetupNextStepsTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Codex runtime" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Choose how TokenFish starts the existing Codex app server. Changes are saved for the next launch."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="RuntimeModeLabel"
                        FontWeight="SemiBold"
                        Text="Runtime mode" />
                    <ComboBox
                        x:Name="RuntimeModeComboBox"
                        MinWidth="260"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Runtime mode"
                        SelectionChanged="OnRuntimeModeSelectionChanged" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="WslDistributionLabel"
                        FontWeight="SemiBold"
                        Text="WSL distribution name" />
                    <TextBox
                        x:Name="WslDistributionTextBox"
                        AutomationProperties.Name="WSL distribution name"
                        PlaceholderText="Optional"
                        TextChanged="OnWslDistributionTextChanged" />
                    <TextBlock
                        x:Name="CodexSettingsRetainedTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="ClaudeBridgeDescriptionTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="WslDistributionHelpTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Leave empty to use the default WSL distribution."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    x:Name="RestartStatusBorder"
                    Padding="10,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Restart required" />
                        <TextBlock
                            x:Name="RestartStatusTextBlock"
                            AutomationProperties.LiveSetting="Polite"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Current" />
                            <TextBlock
                                x:Name="CurrentProviderModeTextBlock"
                                Grid.Column="1"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Row="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Saved" />
                            <TextBlock
                                x:Name="SavedProviderModeTextBlock"
                                Grid.Row="1"
                                Grid.Column="1"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="StatusBorder"
                    Padding="10,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="StatusTextBlock"
                        AutomationProperties.LiveSetting="Polite"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            <StackPanel x:Name="DesktopPanel" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="A little fish in your corner" FontSize="18" FontWeight="SemiBold" />
                <CheckBox x:Name="WidgetVisibleCheckBox" Content="Show desktop widget" Checked="OnVisualOptionChanged" Unchecked="OnVisualOptionChanged" />
                <TextBlock Text="Shows one usage line per enabled provider. Click a fish to open the full view. Hiding the widget keeps TokenFish in the tray." TextWrapping="Wrap" Foreground="{ThemeResource PopupTextSecondaryBrush}" />
                <CheckBox x:Name="WidgetOnTopCheckBox" Content="Always on top" Checked="OnVisualOptionChanged" Unchecked="OnVisualOptionChanged" />
                <TextBlock Text="Keep the widget above other applications when you want it in view." TextWrapping="Wrap" Foreground="{ThemeResource PopupTextSecondaryBrush}" />
                <ComboBox x:Name="WidgetCornerComboBox" Header="Corner" HorizontalAlignment="Stretch" SelectionChanged="OnVisualSelectionChanged">
                    <ComboBoxItem Content="Bottom right" Tag="BottomRight" />
                    <ComboBoxItem Content="Bottom left" Tag="BottomLeft" />
                    <ComboBoxItem Content="Top right" Tag="TopRight" />
                    <ComboBoxItem Content="Top left" Tag="TopLeft" />
                </ComboBox>
                <TextBlock Text="Drag the handle to move between displays. Settings and the full view open beside the surface you used." TextWrapping="Wrap" Foreground="{ThemeResource PopupTextSecondaryBrush}" />
            </StackPanel>
            <StackPanel x:Name="AppearancePanel" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="One look across TokenFish" FontSize="18" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemeComboBox" Header="Appearance" HorizontalAlignment="Stretch" SelectionChanged="OnVisualSelectionChanged">
                    <ComboBoxItem Content="System" Tag="System" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
                <TextBlock Text="Applies immediately to the widget, usage view, and Settings. Windows high contrast takes priority." TextWrapping="Wrap" Foreground="{ThemeResource PopupTextSecondaryBrush}" />
                <TextBlock x:Name="VersionTextBlock" Foreground="{ThemeResource PopupTextSecondaryBrush}" />
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VisualStatusTextBlock" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" />

            <Button
                x:Name="CloseButton"
                Grid.Column="1"
                Click="OnCloseClicked"
                Content="Close" />
            <Button
                x:Name="SaveButton"
                Grid.Column="2"
                Click="OnSaveClicked"
                Content="Save" />
        </Grid>
    </Grid>
</Window>
