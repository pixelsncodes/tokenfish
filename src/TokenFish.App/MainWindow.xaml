<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TokenFish.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TokenFish"
    mc:Ignorable="d">
    <Grid
        x:Name="RootGrid"
        Padding="16,14"
        Background="#0B111A"
        RequestedTheme="Dark"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image
                x:Name="HeaderIcon"
                Width="26"
                Height="26"
                Visibility="Collapsed" />

            <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="TokenFish" />
                <TextBlock
                    x:Name="StatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Starting TokenFish" />
            </StackPanel>

            <Button
                x:Name="SettingsButton"
                Grid.Column="2"
                AutomationProperties.Name="Open TokenFish settings"
                Click="OnSettingsClicked"
                Content="Settings" />

            <Button
                x:Name="RefreshNowButton"
                Grid.Column="3"
                AutomationProperties.Name="Refresh usage now"
                Click="OnRefreshNowClicked"
                Content="Refresh" />
        </Grid>

        <Border
            x:Name="StatusBanner"
            Grid.Row="1"
            Padding="10,8"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="Collapsed">
            <TextBlock x:Name="StatusBannerText" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer
            x:Name="ProvidersScrollViewer"
            Grid.Row="2"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ProvidersPanel" Spacing="10" />
        </ScrollViewer>

        <TextBlock
            x:Name="RefreshCommandStatusText"
            Grid.Row="3"
            AutomationProperties.LiveSetting="Polite"
            Foreground="#B4C0D0"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</Window>
