<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TokenFish.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TokenFish"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Padding="16"
        RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image
                x:Name="HeaderIcon"
                Width="24"
                Height="24"
                Visibility="Collapsed" />

            <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="TokenFish" />
                <TextBlock
                    x:Name="StatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Starting TokenFish" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="StatusBanner"
            Grid.Row="1"
            Padding="10,8"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="Collapsed">
            <TextBlock x:Name="StatusBannerText" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer
            x:Name="ProvidersScrollViewer"
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProvidersPanel" Spacing="10" />
        </ScrollViewer>

        <Grid
            Grid.Row="3"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="RefreshCommandStatusText"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <Button
                x:Name="RefreshNowButton"
                Grid.Column="1"
                AutomationProperties.Name="Refresh usage now"
                Click="OnRefreshNowClicked"
                Content="Refresh now" />
        </Grid>
    </Grid>
</Window>
