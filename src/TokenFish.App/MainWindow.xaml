<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TokenFish.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TokenFish"
    mc:Ignorable="d">
    <Grid
        x:Name="RootGrid"
        Padding="20"
        Background="{ThemeResource TokenFishSurfaceBrush}"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Canvas
                Width="25"
                Height="25"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False">
                <Polygon
                    Fill="{ThemeResource TokenFishBrandBrush}"
                    Canvas.Left="1"
                    Canvas.Top="1"
                    Points="0,0 17.94,0 23,7.82 16.79,11.5 23,15.18 17.94,23 0,23 2.76,14.26 0,11.5 2.76,8.74" />
                <Rectangle
                    Width="8"
                    Height="8"
                    Canvas.Left="-3"
                    Canvas.Top="9"
                    Fill="{ThemeResource TokenFishBrandBrush}"
                    Opacity="0.8">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="45" CenterX="4" CenterY="4" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle
                    Width="4"
                    Height="4"
                    Canvas.Left="10"
                    Canvas.Top="6"
                    Fill="#071016" />
            </Canvas>

            <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PopupTextPrimaryBrush}"
                    Text="TokenFish" />
                <TextBlock
                    x:Name="StatusText"
                    Foreground="{ThemeResource PopupTextSecondaryBrush}"
                    Text="Starting TokenFish" />
            </StackPanel>

            <Button
                x:Name="SettingsButton"
                Grid.Column="2"
                Width="36"
                Height="36"
                Padding="0"
                AutomationProperties.Name="Settings"
                Click="OnSettingsClicked"
                ToolTipService.ToolTip="Settings">
                <Viewbox
                    AutomationProperties.AccessibilityView="Raw"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <SymbolIcon
                        AutomationProperties.AccessibilityView="Raw"
                        Symbol="Setting" />
                </Viewbox>
            </Button>

            <Button
                x:Name="RefreshNowButton"
                Grid.Column="3"
                Width="36"
                Height="36"
                Padding="0"
                AutomationProperties.Name="Refresh now"
                Click="OnRefreshNowClicked"
                ToolTipService.ToolTip="Refresh now">
                <Viewbox
                    AutomationProperties.AccessibilityView="Raw"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <SymbolIcon
                        AutomationProperties.AccessibilityView="Raw"
                        Symbol="Refresh" />
                </Viewbox>
            </Button>
            <Button Grid.Column="4" Width="30" Height="30" Padding="0" AutomationProperties.Name="Hide full view" ToolTipService.ToolTip="Hide full view" Click="OnHideClicked"><SymbolIcon Symbol="Cancel" /></Button>
        </Grid>

        <Border
            x:Name="StatusBanner"
            Grid.Row="1"
            Padding="10,8"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="Collapsed">
            <TextBlock
                x:Name="StatusBannerText"
                Foreground="{ThemeResource PopupTextPrimaryBrush}"
                TextWrapping="Wrap" />
        </Border>

        <ScrollViewer
            x:Name="ProvidersScrollViewer"
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProvidersPanel" Spacing="10" />
        </ScrollViewer>

        <TextBlock
            x:Name="RefreshCommandStatusText"
            Grid.Row="3"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource PopupTextSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <Grid Grid.Row="4" ColumnSpacing="8" Padding="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Local integrations" FontSize="12" Foreground="{ThemeResource PopupTextSecondaryBrush}" VerticalAlignment="Center" />
            <Button x:Name="WidgetButton" Grid.Column="1" Content="Show desktop widget" Click="OnWidgetClicked" FontSize="12" />
        </Grid>
    </Grid>
</Window>
