<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TokenFish.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TokenFish"
    mc:Ignorable="d">
    <Grid
        x:Name="RootGrid"
        Padding="16,14"
        Background="#0B111A"
        RequestedTheme="Dark"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Canvas
                Width="26"
                Height="20"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False">
                <Polygon
                    Fill="#E8FF4D"
                    Points="8,10 1,3 3,10 1,17" />
                <Ellipse
                    Width="16"
                    Height="11"
                    Canvas.Left="6"
                    Canvas.Top="4.5"
                    Fill="#E8FF4D" />
                <Polygon
                    Canvas.Left="18"
                    Canvas.Top="6"
                    Fill="#0B111A"
                    Points="0,4 8,0 5,4" />
                <Polygon
                    Canvas.Left="18"
                    Canvas.Top="10"
                    Fill="#0B111A"
                    Points="0,0 8,4 5,0" />
                <Ellipse
                    Width="2.5"
                    Height="2.5"
                    Canvas.Left="17"
                    Canvas.Top="6.5"
                    Fill="#0B111A" />
            </Canvas>

            <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PopupTextPrimaryBrush}"
                    Text="TokenFish" />
                <TextBlock
                    x:Name="StatusText"
                    Foreground="{StaticResource PopupTextSecondaryBrush}"
                    Text="Starting TokenFish" />
            </StackPanel>

            <Button
                x:Name="SettingsButton"
                Grid.Column="2"
                AutomationProperties.Name="Open TokenFish settings"
                Click="OnSettingsClicked"
                Content="Settings" />

            <Button
                x:Name="RefreshNowButton"
                Grid.Column="3"
                AutomationProperties.Name="Refresh usage now"
                Click="OnRefreshNowClicked"
                Content="Refresh" />
        </Grid>

        <Border
            x:Name="StatusBanner"
            Grid.Row="1"
            Padding="10,8"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="Collapsed">
            <TextBlock
                x:Name="StatusBannerText"
                Foreground="{StaticResource PopupTextPrimaryBrush}"
                TextWrapping="Wrap" />
        </Border>

        <ScrollViewer
            x:Name="ProvidersScrollViewer"
            Grid.Row="2"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ProvidersPanel" Spacing="10" />
        </ScrollViewer>

        <TextBlock
            x:Name="RefreshCommandStatusText"
            Grid.Row="3"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{StaticResource PopupTextSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</Window>
