<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TokenFish.App.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TokenFish Setup">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="RootGrid" Padding="36" Background="{ThemeResource TokenFishSurfaceBrush}" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="TOKENFISH" Foreground="{ThemeResource TokenFishBrandBrush}" FontWeight="SemiBold" />
                <TextBlock x:Name="StepTextBlock" Foreground="{ThemeResource PopupTextSecondaryBrush}" AutomationProperties.Name="Setup progress" />
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="16">
                <TextBlock x:Name="TitleTextBlock" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource PopupTextPrimaryBrush}" />
                <TextBlock x:Name="DescriptionTextBlock" TextWrapping="Wrap" Foreground="{ThemeResource PopupTextPrimaryBrush}" />
                <StackPanel x:Name="ProviderSelectionPanel" Spacing="8">
                    <CheckBox x:Name="ClaudeCheckBox" Content="Claude" Foreground="#FF8B78" />
                    <CheckBox x:Name="CodexCheckBox" Content="Codex" Foreground="#4AD1C0" />
                </StackPanel>
                <StackPanel x:Name="RuntimePanel" Spacing="8">
                    <ComboBox x:Name="RuntimeModeComboBox" SelectionChanged="OnRuntimeModeChanged">
                        <ComboBoxItem Content="Native Windows" Tag="NativeWindows" />
                        <ComboBoxItem Content="WSL direct" Tag="Wsl" />
                        <ComboBoxItem Content="WSL login shell" Tag="WslLoginShell" />
                    </ComboBox>
                    <TextBox x:Name="WslDistributionTextBox" Header="Optional WSL distribution" />
                </StackPanel>
                <StackPanel x:Name="ClaudePanel" Spacing="8">
                    <TextBlock Text="Copy this status-line snippet, merge it into Claude Code settings, use Claude Code normally, then return here to recheck." TextWrapping="Wrap" />
                    <TextBlock Text="Claude Code on Windows" />
                    <TextBox x:Name="ClaudeSnippetTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" />
                    <Button Content="Copy Windows snippet" Click="OnCopyClicked" HorizontalAlignment="Left" />
                    <TextBlock Text="Claude Code inside WSL" />
                    <TextBox x:Name="ClaudeWslSnippetTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" />
                    <Button Content="Copy WSL snippet" Click="OnCopyWslClicked" HorizontalAlignment="Left" />
                    <TextBlock x:Name="CopyStatusTextBlock" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel x:Name="VerificationPanel" Spacing="8">
                    <TextBlock x:Name="VerificationSummaryTextBlock" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                    <StackPanel x:Name="VerificationProvidersPanel" Spacing="8" />
                    <ProgressRing x:Name="RecheckProgressRing" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Checking provider readiness" />
                    <Button x:Name="RecheckButton" Content="Recheck" AutomationProperties.Name="Recheck provider readiness" Click="OnRecheckClicked" HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock" Foreground="#FFB4AB" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="NotNowButton" Content="Not now" Click="OnNotNowClicked" />
                <Button x:Name="BackButton" Content="Back" Click="OnBackClicked" />
                <Button x:Name="ContinueButton" Content="Continue" Click="OnContinueClicked" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
